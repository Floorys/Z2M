main_menu() {
	while :; do
		header
		mi 1 "Быстрая настройка"
		if installed; then
			msub "перепроверить и подобрать заново"
		else
			msub "ставлю zapret2 и настраиваю всё сам"
		fi
		say ""
		mi 2 "Обход блокировок"
		mi 3 "Сайты и исключения"
		mi 4 "Проверка"
