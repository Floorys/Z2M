			4) do_uninstall; pause ;;
			5) quic_status; printf '\n  1) включить  2) выключить  Enter — назад: '; read -r x
			   case "$x" in 1) quic_on ;; 2) quic_off ;; esac; pause ;;
			6) printf '  1) включить IPv6  2) выключить  Enter — назад: '; read -r x
			   case "$x" in 1) ipv6_set on ;; 2) ipv6_set off ;; esac; pause ;;
