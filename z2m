menu_service() {
	while :; do
		header
		crumb "Проверка"
		if daemon_running; then mi 1 "Выключить обход"; else mi 1 "Включить обход"; fi
		mi 2 "Перезапустить"
		say ""
		mi 3 "Состояние"
		mi 4 "Найти проблемы"
		mi 5 "Проверить сайты"
		mi 6 "Логи"
