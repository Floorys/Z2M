		say "   5) Система"
		say ""
		say "   s) Start/Stop zapret2"
		say "   0) Выход"
		printf '\n  выбор: '; read -r c
		case "$c" in
			1) menu_install ;;
			2) menu_strategy ;;
			3) menu_lists ;;
			4) menu_service ;;
			5) menu_system ;;
			s|S) if daemon_running; then svc stop; else svc start; fi; pause ;;
			0|q|"") clear 2>/dev/null; exit 0 ;;
		esac
	done
}

usage() {
	cat <<EOF
z2m $Z2M_VERSION — Zapret2 Manager for OpenWrt

Без аргументов запускается интерактивное меню.

Установка
  z2m install [url]        установить/обновить zapret2 (последний релиз)
  z2m pick                 выбрать конкретную версию релиза
  z2m local [file.zip]     установить из локального zip
  z2m uninstall            удалить zapret2
  z2m install-self         установить сам z2m в $SELF_PATH
  z2m update-self          обновить z2m из своего репозитория

Стратегии
  z2m strategy             список пресетов
  z2m strategy <id|номер>  применить пресет
  z2m strategy show <id>   показать пресет
  z2m strategy save <имя>  сохранить текущую стратегию как пресет
  z2m strategy edit        править строку стратегии в редакторе
  z2m test                 автоподбор: прогнать все пресеты по доменам
  z2m blockcheck           запустить штатный blockcheck2.sh

Списки
  z2m list                 показать hostlist
  z2m list add d1 d2 ...   добавить домены
  z2m list del d1 d2 ...   удалить домены
  z2m list exclude         показать hostlist-exclude
  z2m list bundle          показать готовые наборы
  z2m list bundle <имя>    добавить набор

Сервис
  z2m status | doctor | log
  z2m start | stop | restart | restart-daemons | fw
  z2m enable | disable
  z2m backup | restore
  z2m quic on|off|status
  z2m ipv6 on|off
  z2m version | help

Переменные окружения
  Z2M_YES=1        не задавать вопросов
  Z2M_ARCH=...     переопределить архитектуру
  Z2M_TIMEOUT=7    таймаут одного домена в тесте
  Z2M_SETTLE=3     пауза после применения стратегии
  Z2M_NOCOLOR=1    без цвета
EOF
}

# ------------------------------------------------------------------ старт --
case "${1:-}" in
	version|-v|--version) say "z2m $Z2M_VERSION"; exit 0 ;;
	help|-h|--help)       usage; exit 0 ;;
esac

[ "$(id -u)" = "0" ] || die "нужны права root"
detect_env
mkdir -p "$WORK" "$CFGDIR" "$BACKUP_DIR" "$STRAT_DIR" "$LISTS_DIR" 2>/dev/null

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
	"")               ensure_strategies; main_menu ;;
	install|update)   Z2M_BATCH=1; detect_cfg; do_install "${1:-}" ;;
	pick)             detect_cfg; pick_version ;;
	local)            Z2M_BATCH=1; detect_cfg; install_local "${1:-}" ;;
	uninstall|remove) Z2M_BATCH=1; detect_cfg; do_uninstall ;;
	install-self)     install_self ;;
	update-self)      update_self ;;
	strategy|strat)
		case "${1:-}" in
			""|list) strat_list ;;
			show)    shift; strat_show "${1:-}" ;;
			save)    shift; strat_save "${1:-}" ;;
			edit)    strat_edit ;;
			*)       strat_apply "$1" ;;
		esac ;;
	test)             Z2M_BATCH=1; test_all ;;
	blockcheck)       blockcheck ;;
	list|hostlist)
		case "${1:-}" in
			""|show)        hl_show user ;;
			add)            shift; hl_add user "$@" ;;
			del|rm)         shift; hl_del user "$@" ;;
			exclude|excl)   shift
				case "${1:-}" in
					add) shift; hl_add exclude "$@" ;;
					del|rm) shift; hl_del exclude "$@" ;;
					*) hl_show exclude ;;
				esac ;;
			bundle)         shift; if [ -n "${1:-}" ]; then bundle_add "$1"; else bundle_list; fi ;;
			*)              hl_show user ;;
		esac ;;
	status)           status ;;
	doctor|check)     doctor ;;
	log)              tail -n 50 "$LOGF" 2>/dev/null || warn "лога ещё нет" ;;
	start|stop|restart) svc "$cmd" ;;
	restart-daemons|restart_daemons) svc restart_daemons ;;
	fw)               svc restart_fw ;;
	enable|disable)   svc "$cmd" ;;
	backup)           detect_cfg; backup_cfg ;;
	restore)          detect_cfg; restore_cfg ;;
	quic)
		case "${1:-status}" in
			on)  quic_on ;;
			off) quic_off ;;
			*)   quic_status ;;
		esac ;;
	ipv6)             ipv6_set "${1:-}" ;;
	*)                err "неизвестная команда: $cmd"; say ""; usage; exit 1 ;;
esac
