#!/bin/sh
# Zapret2 Manager for OpenWrt (Routerich zapret2 / nfqws2)
Z2M_VER="0.1.0"
D=/opt/z2m; S=$D/strategies; BAK=/root/z2m.bak; CFG=/opt/zapret2/config
NFQ=/opt/zapret2/nfq2/nfqws2
LUA="--lua-init=@/opt/zapret2/lua/zapret-lib.lua --lua-init=@/opt/zapret2/lua/zapret-antidpi.lua --lua-init=@/opt/zapret2/lua/zapret-auto.lua"
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; N='\033[0m'

m(){ printf "%b\n" "$1"; }
pause(){ printf "\nEnter..."; read x; }

need_zapret2(){
  [ -x "$NFQ" ] || { m "${R}не найден $NFQ - сначала установи zapret2${N}"; exit 1; }
  uci -q get zapret2.main >/dev/null || { m "${R}нет UCI-конфига zapret2${N}"; exit 1; }
}

hdr(){ clear
  if ps w | grep -q '[n]fqws2'; then st="${G}РАБОТАЕТ${N}"; else st="${R}ОСТАНОВЛЕН${N}"; fi
  pr=$(( $(grep -c -- '--new' $CFG 2>/dev/null) + 1 ))
  qn=$(uci -q get zapret2.main.qnum); [ -z "$qn" ] && qn=300
  qc=$(awk -v q="$qn" '$1==q{print $3}' /proc/net/netfilter/nfnetlink_queue 2>/dev/null); [ -z "$qc" ] && qc="-"
  m "${C}=== Zapret2 Manager v$Z2M_VER (OpenWrt) ===${N}"
  m " статус: $st | профилей: $pr | обработано пакетов (q$qn): $qc"
  m "${C}------------------------------------------${N}"; }

gen(){ L=$(uci show zapret2 | sed -n 's/^zapret2\.\(list_hosts_[A-Za-z0-9_]*\)=.*/\1/p' | sort -u | tr '\n' ' ')
  awk -v lists="$L" -v Q="'" -f $D/lib/port.awk "$1" > /tmp/z2m.uci; }

apply(){ gen "$1"; uci export zapret2 > $BAK
  service zapret2 stop >/dev/null 2>&1
  for s in $(uci show zapret2 | sed -n 's/^zapret2\.\([A-Za-z0-9_]*\)=strategy$/\1/p'); do uci -q delete zapret2.$s; done
  sh /tmp/z2m.uci >/dev/null 2>&1 && uci commit zapret2 && service zapret2 restart >/dev/null 2>&1
  sleep 2; ps w | grep -q '[n]fqws2'; }

rollback(){ uci import zapret2 < $BAK && uci commit zapret2 && service zapret2 restart >/dev/null 2>&1; }
why(){ . $CFG; $NFQ --intercept=0 --qnum=300 $LUA $NFQWS2_OPT 2>&1 | tail -8; }
hit(){ curl -s -o /dev/null -w '%{http_code}' --max-time 6 "$1" 2>/dev/null; }
chk(){ m " discord: $(hit https://discord.com/app)   youtube: $(hit https://www.youtube.com)   (2xx/3xx = ок)"; }

m_str(){ hdr; i=0
  for f in $S/*.txt; do i=$((i+1)); eval "F$i='$f'"; printf " %d) %s\n" $i "$(basename $f .txt)"; done
  m " 0) назад"; printf "выбор: "; read a; [ "$a" = 0 ] && return
  eval "f=\$F$a"; [ -z "$f" ] && return
  m "${C}применяю $(basename $f .txt)${N}"
  if apply "$f"; then m "${G}демон работает${N}"; chk; grep -h 'ВНИМАНИЕ' /tmp/z2m.uci
  else m "${R}не запустилась, причина:${N}"; why; rollback; m "${Y}откат выполнен${N}"; fi; pause; }

pick(){ best=""; bs=-1
  for f in "$1"/*.txt; do printf "%-30s " "$(basename $f .txt)"
    if apply "$f"; then d=$(hit https://discord.com/app); y=$(hit https://www.youtube.com); s=0
      case "$d" in 2*|3*) s=$((s+1));; esac; case "$y" in 2*|3*) s=$((s+1));; esac
      printf "discord=%s youtube=%s счёт=%d\n" "$d" "$y" "$s"
      [ $s -gt $bs ] && { bs=$s; best=$f; }
    else printf "ошибка запуска\n"; fi; done
  if [ -n "$best" ]; then m "${G}лучшая: $(basename $best .txt), счёт $bs${N}"; apply "$best"
  else m "${R}ни одна не заработала${N}"; fi; pause; }

split_custom(){ [ -r /root/custom_test.txt ] || { m "${R}нет /root/custom_test.txt${N}"; pause; return 1; }
  rm -rf /tmp/z2m.c; mkdir -p /tmp/z2m.c
  awk '/^#/{n++; nm=substr($0,2); gsub(/[^A-Za-z0-9_.-]/,"_",nm); f=sprintf("/tmp/z2m.c/%02d-%s.txt",n,nm); next} n>0{print > f}' /root/custom_test.txt; }

m_pick(){ hdr
  m " 1) перебрать встроенные стратегии"
  m " 2) перебрать /root/custom_test.txt"
  m " 3) проверить текущую"
  m " 4) запустить blockcheck2"
  m " 0) назад"; printf "выбор: "; read a
  case "$a" in 1) pick "$S";; 2) split_custom && pick /tmp/z2m.c;; 3) chk; pause;;
   4) if [ -x /opt/zapret2/blockcheck2.sh ]; then /opt/zapret2/blockcheck2.sh
      else m "${Y}blockcheck2.sh не найден, используй вкладку Blockcheck2 в LuCI${N}"; fi; pause;; esac; }

m_port(){ hdr; m "вставь стратегию из Zapret2UI, затем Ctrl+D:"; cat > /tmp/z2m.in
  m "\n${C}--- что получится ---${N}"; gen /tmp/z2m.in; cat /tmp/z2m.uci
  printf "\nприменить? [y/N]: "; read a; [ "$a" = y ] || return
  if apply /tmp/z2m.in; then m "${G}демон работает${N}"; chk
    printf "сохранить как пресет? имя (пусто = нет): "; read nm
    [ -n "$nm" ] && cp /tmp/z2m.in "$S/$nm.txt"
  else m "${R}не запустилась, причина:${N}"; why; rollback; m "${Y}откат выполнен${N}"; fi; pause; }

m_lists(){ hdr; wc -l /opt/zapret2/ipset/zapret_hosts_*.txt 2>/dev/null
  m "\n 1) добавить домен в user"
  m " 2) добавить домен в исключения"
  m " 3) обновить встроенные списки"
  m " 4) бэкап списков в /root/ipset.bak"
  m " 0) назад"; printf "выбор: "; read a
  case "$a" in
   1) printf "домен: "; read h; echo "$h" >> /opt/zapret2/ipset/zapret_hosts_user.txt; service zapret2 restart;;
   2) printf "домен: "; read h; echo "$h" >> /opt/zapret2/ipset/zapret_hosts_user_exclude.txt; service zapret2 restart;;
   3) for g in /opt/zapret2/ipset/get_*.sh; do [ -x "$g" ] && sh "$g"; done; service zapret2 restart;;
   4) cp -a /opt/zapret2/ipset /root/ipset.bak && m "${G}скопировано${N}";;
   *) return;; esac; pause; }

m_set(){ hdr
  m " TCP порты: $(uci -q get zapret2.main.nfqws_ports_tcp)"
  m " UDP порты: $(uci -q get zapret2.main.nfqws_ports_udp)"
  m " IPv6: $(uci -q get zapret2.main.enable_ipv6)  POSTNAT: $(uci -q get zapret2.main.postnat)  свои скрипты: $(uci -q get zapret2.main.custom_scripts)"
  m " пакетов tcp_out/udp_out: $(uci -q get zapret2.main.nfqws_tcp_pkt_out)/$(uci -q get zapret2.main.nfqws_udp_pkt_out)"
  m "\n 1) TCP порты"
  m " 2) UDP порты"
  m " 3) вкл/выкл пользовательские скрипты"
  m " 4) лимит UDP исходящих пакетов"
  m " 5) вкл/выкл QUIC-профили"
  m " 6) вкл/выкл обработку IPv6"
  m " 0) назад"; printf "выбор: "; read a
  case "$a" in
   1) printf "значение (напр. 443 или 443-65535): "; read v; uci set zapret2.main.nfqws_ports_tcp="$v";;
   2) printf "значение: "; read v; uci set zapret2.main.nfqws_ports_udp="$v";;
   3) c=$(uci -q get zapret2.main.custom_scripts); [ "$c" = 1 ] && uci set zapret2.main.custom_scripts=0 || uci set zapret2.main.custom_scripts=1;;
   4) printf "значение (9-15): "; read v; uci set zapret2.main.nfqws_udp_pkt_out="$v";;
   5) printf "включить QUIC-профили? [y/n]: "; read v
      for s in $(uci show zapret2 | sed -n 's/^zapret2\.\([A-Za-z0-9_]*\)=strategy$/\1/p'); do
        [ "$(uci -q get zapret2.$s.filter_l7)" = quic ] && { [ "$v" = y ] && uci set zapret2.$s.enabled=1 || uci set zapret2.$s.enabled=0; }; done;;
   6) c=$(uci -q get zapret2.main.enable_ipv6); [ "$c" = 1 ] && uci set zapret2.main.enable_ipv6=0 || uci set zapret2.main.enable_ipv6=1;;
   *) return;; esac
  uci commit zapret2; service zapret2 restart; pause; }

m_diag(){ hdr
  m "${C}--- очередь (3-е число = обработано) ---${N}"; cat /proc/net/netfilter/nfnetlink_queue 2>/dev/null
  m "${C}--- процессы ---${N}"; ps w | grep '[n]fqws2' || m "${R}не работает${N}"
  m "${C}--- CPU ---${N}"; top -bn1 | grep '[n]fqws2'
  m "${C}--- IPv6 (есть global = трафик может идти мимо) ---${N}"; ip -6 addr show | grep 'scope global' || m "нет"
  m "${C}--- DNS ---${N}"; nslookup discord.com 127.0.0.1 2>/dev/null | tail -4
  m "${C}--- проверка аргументов nfqws2 ---${N}"; why
  m "${C}--- лог ---${N}"; logread | grep -i -e zapret -e nfqws | tail -10; pause; }

m_bak(){ hdr
  m " 1) бэкап конфига сейчас"
  m " 2) откат к последнему бэкапу"
  m " 3) показать текущие секции"
  m " 4) экспорт в /root/zapret2.export"
  m " 0) назад"; printf "выбор: "; read a
  case "$a" in 1) uci export zapret2 > $BAK; m "${G}сохранено в $BAK${N}";;
   2) rollback; sleep 2; ps w | grep -q '[n]fqws2' && m "${G}откат ок${N}" || m "${R}демон не поднялся${N}";;
   3) uci show zapret2 | grep -e '=strategy' -e '\.script=';;
   4) uci export zapret2 > /root/zapret2.export; m "${G}готово${N}";;
   *) return;; esac; pause; }

m_sys(){ hdr
  m " 1) старт zapret2"
  m " 2) стоп zapret2"
  m " 3) рестарт zapret2"
  m " 4) автозапуск вкл"
  m " 5) FIX: выключить flow offloading"
  m " 6) показать версии"
  m " 7) удалить менеджер"
  m " 0) назад"; printf "выбор: "; read a
  case "$a" in 1) service zapret2 start;; 2) service zapret2 stop;; 3) service zapret2 restart;;
   4) service zapret2 enable; m "${G}включён${N}";;
   5) uci set zapret2.main.flowoffload=donttouch
      uci -q set firewall.@defaults[0].flow_offloading=0
      uci -q set firewall.@defaults[0].flow_offloading_hw=0
      uci commit; service firewall restart; service zapret2 restart; m "${G}готово${N}";;
   6) m "z2m $Z2M_VER"; $NFQ --version | head -3; . /etc/openwrt_release 2>/dev/null; m "$DISTRIB_DESCRIPTION";;
   7) rm -rf /opt/z2m /usr/bin/z2m; m "${Y}удалено${N}"; exit 0;;
   *) return;; esac; pause; }

need_zapret2
while :; do hdr
  m " 1) Стратегии - выбрать и применить"
  m " 2) Подбор и тест"
  m " 3) Портировать стратегию из Zapret2UI"
  m " 4) Хостлисты"
  m " 5) Настройки перехвата"
  m " 6) Диагностика"
  m " 7) Бэкап и откат"
  m " 8) Системное меню"
  m " 0) Выход"
  printf "выбор: "; read a
  case "$a" in 1) m_str;; 2) m_pick;; 3) m_port;; 4) m_lists;; 5) m_set;; 6) m_diag;; 7) m_bak;; 8) m_sys;; 0) exit 0;; esac
done
