		if autostart_on; then mi 7 "Автозапуск: выключить"; else mi 7 "Автозапуск: включить"; fi
		say ""
		mi 0 "Назад"
		prompt; read -r c
		case "$c" in
			1) if daemon_running; then svc stop; else svc start; fi; pause ;;
			2) svc restart; pause ;;
			3) status; pause ;;
			4) doctor; pause ;;
			5) run_probes; pause ;;
			6) logread -e nfqws2 2>/dev/null | tail -n 40 | sed 's/^/    /'; pause ;;
			7) if autostart_on; then svc disable; ok "автозапуск выключен"; else svc enable; ok "автозапуск включён"; fi; pause ;;
			0|q|"") return 0 ;;
