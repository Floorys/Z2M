#!/bin/sh
# z2m — Zapret2 Manager for OpenWrt
# Управление пакетами zapret2 (remittor/zapret-openwrt) прямо с роутера:
# установка, стратегии nfqws2, hostlist'ы, автоподбор, диагностика.
#
# License: MIT

set -u

Z2M_VERSION="0.4.1"

# ---------------------------------------------------------------- настройки --
PKG_REPO="${Z2M_PKG_REPO:-remittor/zapret-openwrt}"   # откуда берём пакеты zapret2
SELF_REPO="${Z2M_SELF_REPO:-FunnyDragon2010/Z2M}"                        # owner/repo самого z2m (для update-self)
SELF_BRANCH="${Z2M_SELF_BRANCH:-main}"
PKG_PREFIX="zapret2"                                  # префикс имён файлов в релизе
PKG_TAG_RE="${Z2M_TAG_RE:-v0\.9\.[0-9]\{8\}}"           # как выглядят теги релизов zapret2
FALLBACK_TAG="${Z2M_FALLBACK_TAG:-v0.9.20260307}"     # если GitHub не ответил списком версий
GH_UA="z2m/$Z2M_VERSION"
# зеркала github — пробуются, если прямой доступ не работает
MIRRORS="${Z2M_MIRRORS:-https://gh-proxy.com/ https://ghfast.top/}"
# известные версии на случай, если GitHub не отдаёт список
KNOWN_TAGS="v0.9.20260307 v0.9.20260226 v0.9.20260221 v0.9.20260212 v0.9.20260208"

SELF_PATH="/usr/bin/z2m"
CFGDIR="/etc/z2m"
STRAT_DIR="$CFGDIR/strategies"
LISTS_DIR="$CFGDIR/lists"
BACKUP_DIR="$CFGDIR/backup"
RESULTS="$CFGDIR/test-results.txt"
DOMAINS_FILE="$CFGDIR/test-domains.txt"
LOGF="$CFGDIR/z2m.log"
WORK="/tmp/z2m"
PROBE_FAIL="/tmp/z2m/probe.fail"

INIT="/etc/init.d/zapret2"
ZDIR="/opt/zapret2"
NFQ="$ZDIR/nfq2/nfqws2"
FILE_CFG="$ZDIR/config"
UCI_FILE="/etc/config/zapret2"
HOSTS_USER="$ZDIR/ipset/zapret-hosts-user.txt"
HOSTS_EXCL="$ZDIR/ipset/zapret-hosts-user-exclude.txt"

TEST_SETTLE="${Z2M_SETTLE:-1}"     # сек после применения стратегии
TEST_TIMEOUT="${Z2M_TIMEOUT:-5}"   # сек на один домен
TEST_CONNECT="${Z2M_CONNECT:-3}"   # сек на установку соединения
TEST_JOBS="${Z2M_JOBS:-8}"         # сколько доменов проверять одновременно
TEST_MAX_TARGETS="${Z2M_TARGETS:-6}" # сколько заблокированных сайтов брать в тест

# ------------------------------------------------------------------- вывод --
if [ -t 1 ] && [ "${Z2M_NOCOLOR:-0}" != "1" ]; then
	C_R=$(printf '\033[1;31m'); C_G=$(printf '\033[1;32m')
	C_Y=$(printf '\033[1;33m'); C_B=$(printf '\033[1;36m')
	C_D=$(printf '\033[2m');    C_0=$(printf '\033[0m')
else
	C_R=; C_G=; C_Y=; C_B=; C_D=; C_0=
fi

say()  { printf '%s\n' "$*"; }
ok()   { printf '%s\n' "  ${C_G}[ok]${C_0}   $*"; }
info() { printf '%s\n' "  ${C_B}[i]${C_0}    $*"; }
warn() { printf '%s\n' "  ${C_Y}[!]${C_0}    $*"; }
err()  { printf '%s\n' "  ${C_R}[x]${C_0}    $*" >&2; }
die()  { err "$*"; exit 1; }
hr()   { printf '%s\n' "  ${C_D}--------------------------------------------------${C_0}"; }
log()  { [ -d "$CFGDIR" ] && printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGF" 2>/dev/null; return 0; }

ask() {
	[ "${Z2M_YES:-0}" = "1" ] && return 0
	printf '  %s [y/N]: ' "$1"
	read -r _ans
	case "$_ans" in y|Y|yes|YES|д|Д) return 0 ;; *) return 1 ;; esac
}

pause() {
	[ "${Z2M_BATCH:-0}" = "1" ] && return 0
	printf '\n  %s' "— Enter —"
	read -r _x
}

have() { command -v "$1" >/dev/null 2>&1; }

# --------------------------------------------------------------- окружение --
detect_env() {
	if have apk && [ -d /etc/apk ]; then PM=apk
	elif have opkg; then PM=opkg
	else PM=none; fi

	ARCH=""; OWRT=""
	if [ -f /etc/openwrt_release ]; then
		ARCH=$(. /etc/openwrt_release 2>/dev/null; printf '%s' "${DISTRIB_ARCH:-}")
		OWRT=$(. /etc/openwrt_release 2>/dev/null; printf '%s' "${DISTRIB_RELEASE:-}")
	fi
	[ -n "$ARCH" ] || ARCH=$(opkg print-architecture 2>/dev/null \
		| awk '$1=="arch" && $2!="all" && $2!="noarch" {print $2; exit}')
	[ -n "$ARCH" ] || ARCH=$(apk --print-arch 2>/dev/null)
	ARCH="${Z2M_ARCH:-$ARCH}"
	[ -n "$OWRT" ] || OWRT="?"

	MODEL=$(cat /tmp/sysinfo/model 2>/dev/null || printf '?')
	if have nft && nft list tables >/dev/null 2>&1; then FW=nftables; else FW=iptables; fi
}

# ------------------------------------------------------- пакетный менеджер --
pm_name() { case "$PM" in apk) printf 'apk' ;; opkg) printf 'opkg' ;; *) printf 'нет' ;; esac; }

pm_update() {
	case "$PM" in
		apk)  apk update >/dev/null 2>&1 ;;
		opkg) opkg update >/dev/null 2>&1 ;;
	esac
	return 0
}

pm_install_name() {
	case "$PM" in
		apk)  apk add "$1" ;;
		opkg) opkg install "$1" ;;
		*)    return 1 ;;
	esac
}

pm_install_file() {
	case "$PM" in
		apk)  apk add --allow-untrusted "$1" ;;
		opkg) opkg install "$1" ;;
		*)    die "не найден ни opkg, ни apk — непонятно, чем ставить пакеты" ;;
	esac
}

pm_remove() {
	case "$PM" in
		apk)  apk del "$@" ;;
		opkg) opkg remove "$@" ;;
		*)    return 1 ;;
	esac
}

# ------------------------------------------------------------------ сеть ----
# ------------------------------------------------------------------- сеть --
mirror_urls() {
	printf '%s\n' "$1"
	case "$1" in
		https://github.com/*|https://api.github.com/*|https://raw.githubusercontent.com/*)
			for _m in $MIRRORS; do printf '%s%s\n' "$_m" "$1"; done ;;
	esac
}

http_get() {
	if have curl; then curl -fsSL -A "$GH_UA" --connect-timeout 8 --max-time 45 "$1"
	elif have wget; then wget -q -T 20 -O - "$1"
	else return 1; fi
}

# HTTP-код или 000, если проверить не вышло
http_code() {
	if have curl; then
		curl -sIL -A "$GH_UA" --connect-timeout 8 --max-time 20 -o /dev/null -w '%{http_code}' "$1" 2>/dev/null || printf '000'
	else
		printf '000'
	fi
}

http_save() {
	if have curl; then curl -fL -A "$GH_UA" --connect-timeout 8 --progress-bar -o "$2" "$1"
	elif have wget; then wget -q -T 30 -O "$2" "$1"
	else return 1; fi
}

dl_out()  { http_get "$1"; }
dl_file() { http_save "$1" "$2"; }

ensure_tools() {
	if ! have unzip; then
		info "устанавливаю unzip"
		pm_update; pm_install_name unzip >/dev/null 2>&1 || warn "unzip не установился — установка из zip не сработает"
	fi
	if ! have curl && ! have wget; then
		info "устанавливаю curl"
		pm_update; pm_install_name curl >/dev/null 2>&1 || die "нет ни curl, ни wget — скачать релиз нечем"
	fi
}

installed() { [ -x "$INIT" ]; }

# ------------------------------------------------- конфиг: UCI или файл ----
# CFG_MODE=uci|file|none, CFG_PREFIX — префикс вида zapret2.config
detect_cfg() {
	CFG_MODE=none; CFG_PREFIX=""
	if [ -f "$UCI_FILE" ] && have uci; then
		CFG_MODE=uci
		CFG_PREFIX=$(uci -q show zapret2 2>/dev/null | grep -i -m1 '\.nfqws2_opt=' | sed 's/\.[^.]*=.*$//')
		[ -n "$CFG_PREFIX" ] || CFG_PREFIX=$(uci -q show zapret2 2>/dev/null | head -n1 | sed 's/=.*$//' | sed 's/\.[^.]*$//')
		[ -n "$CFG_PREFIX" ] || CFG_PREFIX="zapret2.config"
	elif [ -f "$FILE_CFG" ]; then
		CFG_MODE=file
	fi
}

cfg_key() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

cfg_get() {
	case "$CFG_MODE" in
		uci)  uci -q get "$CFG_PREFIX.$(cfg_key "$1")" ;;
		file) sed -n "s/^$1=//p" "$FILE_CFG" 2>/dev/null | tail -n1 | sed 's/^"//; s/"$//' ;;
		*)    return 1 ;;
	esac
}

cfg_set() {
	_k="$1"; _v="$2"
	case "$CFG_MODE" in
		uci)
			_v=$(printf '%s' "$_v" | tr '\n' ' ')
			uci set "$CFG_PREFIX.$(cfg_key "$_k")=$_v" 2>/dev/null || return 1
			uci commit zapret2 ;;
		file)
			_tmp="$FILE_CFG.z2m.tmp"
			grep -v "^$_k=" "$FILE_CFG" >"$_tmp" 2>/dev/null
			printf '%s="%s"\n' "$_k" "$_v" >>"$_tmp"
			mv "$_tmp" "$FILE_CFG" ;;
		*) return 1 ;;
	esac
}

cfg_edit() {
	case "$CFG_MODE" in
		uci)  ${EDITOR:-vi} "$UCI_FILE"; uci commit zapret2 2>/dev/null ;;
		file) ${EDITOR:-vi} "$FILE_CFG" ;;
		*)    die "конфиг zapret2 не найден" ;;
	esac
	ask "Перезапустить демоны?" && svc restart_daemons
}

backup_cfg() {
	mkdir -p "$BACKUP_DIR"
	_f="$BACKUP_DIR/zapret2-$(date +%Y%m%d-%H%M%S).tar.gz"
	_files=""
	[ -f "$UCI_FILE" ]  && _files="$_files $UCI_FILE"
	[ -f "$FILE_CFG" ]  && _files="$_files $FILE_CFG"
	[ -f "$HOSTS_USER" ] && _files="$_files $HOSTS_USER"
	[ -f "$HOSTS_EXCL" ] && _files="$_files $HOSTS_EXCL"
	[ -n "$_files" ] || { info "нечего бэкапить"; return 0; }
	# shellcheck disable=SC2086
	tar czf "$_f" $_files 2>/dev/null && ok "бэкап: $_f"
	ls -1t "$BACKUP_DIR"/zapret2-*.tar.gz 2>/dev/null | tail -n +11 | while read -r _old; do rm -f "$_old"; done
	log "backup $_f"
}

restore_cfg() {
	ls -1t "$BACKUP_DIR"/zapret2-*.tar.gz >/dev/null 2>&1 || die "бэкапов нет"
	say ""
	_i=0
	for _f in $(ls -1t "$BACKUP_DIR"/zapret2-*.tar.gz); do
		_i=$((_i+1)); printf '  %2d) %s\n' "$_i" "$(basename "$_f")"
	done
	printf '\n  номер (Enter — отмена): '; read -r _n
	[ -n "$_n" ] || return 0
	_f=$(ls -1t "$BACKUP_DIR"/zapret2-*.tar.gz | sed -n "${_n}p")
	[ -n "$_f" ] || die "неверный номер"
	tar xzf "$_f" -C / && ok "восстановлено из $(basename "$_f")"
	installed && svc restart_daemons
}

# ---------------------------------------------------------------- релизы ----
# ----------------------------------------------------------------- релизы --
# Файлы релизов называются строго: zapret2_<тег>_<арх>.zip
# Поэтому вместо многомегабайтного списка релизов через API берём
# только список тегов из самого лёгкого источника, который ответит,
# а годность сборки проверяем фактической закачкой и распаковкой.

arch_candidates() {
	printf '%s\n' "$ARCH"
	case "$ARCH" in
		aarch64_generic) ;;
		aarch64_*)       printf 'aarch64_generic\n' ;;
	esac
}

asset_url() {
	printf 'https://github.com/%s/releases/download/%s/%s_%s_%s.zip\n' \
		"$PKG_REPO" "$1" "$PKG_PREFIX" "$1" "$2"
}

tag_date() {
	_d=$(printf '%s' "$1" | grep -o '[0-9]\{8\}' | head -n1)
	if [ -z "$_d" ]; then printf '%s' "$1"; return 0; fi
	printf '%s.%s.%s' "$(printf '%s' "$_d" | cut -c7-8)" "$(printf '%s' "$_d" | cut -c5-6)" "$(printf '%s' "$_d" | cut -c1-4)"
}

# теги релизов zapret2, свежие сверху
discover_tags() {
	for _s in refs atom page api; do
		case "$_s" in
			refs) _u="https://api.github.com/repos/$PKG_REPO/git/refs/tags?per_page=100"; _n="список тегов" ;;
			atom) _u="https://github.com/$PKG_REPO/releases.atom";                        _n="лента релизов" ;;
			page) _u="https://github.com/$PKG_REPO/releases";                             _n="страница релизов" ;;
			api)  _u="https://api.github.com/repos/$PKG_REPO/releases?per_page=10";       _n="API релизов" ;;
		esac
		for _v in $(mirror_urls "$_u"); do
			_raw=$(http_get "$_v" 2>/dev/null) || continue
			[ -n "$_raw" ] || continue
			_t=$(printf '%s' "$_raw" | grep -o "$PKG_TAG_RE" | sort -ru | head -n 10)
			if [ -n "$_t" ]; then
				printf '  %s[i]%s    источник версий: %s\n' "$C_B" "$C_0" "$_n" >&2
				printf '%s\n' "$_t"
				return 0
			fi
		done
	done
	return 1
}

# скачать и убедиться, что внутри действительно наш пакет
ASSET_USED=""
grab_zip() {
	_c=$(http_code "$1")
	case "$_c" in
		404) return 1 ;;
		403|429) warn "GitHub ответил $_c (лимит запросов) — пробую всё равно" ;;
	esac
	mkdir -p "$WORK"
	rm -f "$WORK/pkg.zip"
	info "качаю $(basename "$1")"
	http_save "$1" "$WORK/pkg.zip" || { warn "скачать не вышло"; return 1; }
	unzip -tq "$WORK/pkg.zip" >/dev/null 2>&1 || { warn "архив битый"; return 1; }
	rm -rf "$WORK/pkg"; mkdir -p "$WORK/pkg"
	unzip -oq "$WORK/pkg.zip" -d "$WORK/pkg" || { warn "не распаковывается"; return 1; }
	if [ -z "$(find_pkg "$WORK/pkg" main)" ]; then
		warn "в архиве нет пакета zapret2 для $(pm_name)"
		return 1
	fi
	ASSET_USED="$1"
	return 0
}

# перебор архитектур и зеркал для одного тега
try_tag() {
	for _a in $(arch_candidates); do
		for _u in $(mirror_urls "$(asset_url "$1" "$_a")"); do
			grab_zip "$_u" && return 0
		done
	done
	return 1
}

install_hint() {
	say ""
	say "  Что можно сделать руками:"
	say "    • взять zip здесь: https://github.com/$PKG_REPO/releases"
	say "    • нужен файл zapret2_<версия>_${ARCH}.zip"
	say "    • положить его в /tmp и выполнить: z2m local"
	say "    • или указать зеркало: Z2M_MIRRORS=https://ваше-зеркало/ z2m install"
}

fetch_unpack() {
	rm -rf "$WORK/pkg" "$WORK/pkg.zip"; mkdir -p "$WORK/pkg"
	info "скачиваю $(basename "$1")"
	dl_file "$1" "$WORK/pkg.zip" || die "скачивание не удалось"
	unzip -oq "$WORK/pkg.zip" -d "$WORK/pkg" || die "распаковка не удалась (нет unzip?)"
}

find_pkg() { # $1 — каталог, $2 — main|luci
	if [ "$PM" = apk ]; then
		case "$2" in
			main) find "$1" -name 'zapret2[-_]*.apk' ! -name 'luci-app-*' 2>/dev/null | head -n1 ;;
			luci) find "$1" -name 'luci-app-zapret2[-_]*.apk' 2>/dev/null | head -n1 ;;
		esac
	else
		case "$2" in
			main) find "$1" -name 'zapret2_*.ipk' ! -name 'luci-app-*' ! -path '*/apk/*' 2>/dev/null | head -n1 ;;
			luci) find "$1" -name 'luci-app-zapret2_*.ipk' ! -path '*/apk/*' 2>/dev/null | head -n1 ;;
		esac
	fi
}

install_pkgs() {
	_main=$(find_pkg "$1" main)
	_luci=$(find_pkg "$1" luci)
	if [ -z "$_main" ]; then
		err "в архиве нет пакета zapret2 для $(pm_name)"
		say "    Содержимое архива:"
		find "$1" -name '*.ipk' -o -name '*.apk' 2>/dev/null | sed 's|^|      |'
		die "нечего устанавливать"
	fi
	info "ставлю $(basename "$_main")"
	pm_install_file "$_main" || die "установка zapret2 не удалась"
	if [ -n "$_luci" ]; then
		info "ставлю $(basename "$_luci")"
		pm_install_file "$_luci" || warn "luci-app не установился (не критично)"
	fi
	ok "пакеты установлены"
	log "installed $(basename "$_main")"
}

selftest() {
	if [ ! -x "$NFQ" ]; then
		err "бинарь $NFQ не найден"
		return 1
	fi
	_out=$("$NFQ" --version 2>&1); _rc=$?
	if [ $_rc -ne 0 ]; then
		err "nfqws2 не запускается (код $_rc) на архитектуре $ARCH"
		say "    $_out"
		say "    Это известная проблема части сборок. Попробуйте другую версию: z2m pick"
		return 1
	fi
	ok "nfqws2 работает: $(printf '%s' "$_out" | head -n1)"
}

do_install() {
	_arg="${1:-${Z2M_TAG:-}}"
	ensure_tools
	mkdir -p "$WORK"
	_got=1
	case "$_arg" in
		http*)
			grab_zip "$_arg" && _got=0 ;;
		"")
			info "ищу релиз zapret2 под $ARCH"
			_tags=$(discover_tags) || _tags=""
			if [ -z "$_tags" ]; then
				warn "GitHub не отдал список версий — беру известные"
				_tags="$FALLBACK_TAG $KNOWN_TAGS"
			fi
			for _t in $(printf '%s\n%s\n' "$_tags" "$FALLBACK_TAG" | awk 'NF && !s[$0]++' | head -n 5); do
				say "  ${C_D}пробую $_t (от $(tag_date "$_t"))${C_0}"
				if try_tag "$_t"; then _got=0; break; fi
			done ;;
		*)
			try_tag "$_arg" && _got=0 ;;
	esac
	if [ "$_got" != 0 ]; then
		err "автоматически скачать пакет не получилось"
		install_hint
		if [ -t 0 ] && [ "${Z2M_YES:-0}" != "1" ]; then
			printf '\n  вставьте прямую ссылку на zip (Enter — отмена): '
			read -r _manual
			[ -n "$_manual" ] || return 1
			grab_zip "$_manual" || return 1
		else
			return 1
		fi
	fi
	ok "архив: $(basename "$ASSET_USED")"
	check_conflicts
	backup_cfg
	install_pkgs "$WORK/pkg"
	detect_cfg
	ensure_strategies
	selftest || return 1
	"$INIT" enable >/dev/null 2>&1
	ok "zapret2 установлен, автозапуск включён"
}

pick_version() {
	ensure_tools
	_tags=$(discover_tags) || _tags=""
	[ -n "$_tags" ] || _tags="$FALLBACK_TAG $KNOWN_TAGS"
	say ""
	say "  ${C_B}Версии zapret2${C_0} ${C_D}— свежие сверху${C_0}"
	say ""
	_i=0
	for _t in $_tags; do
		_i=$((_i+1))
		if [ "$_i" = 1 ]; then
			printf '   %s%d%s  %s   %sот %s · рекомендуется%s\n' "$C_B" "$_i" "$C_0" "$_t" "$C_G" "$(tag_date "$_t")" "$C_0"
		else
			printf '   %s%d%s  %s   %sот %s%s\n' "$C_B" "$_i" "$C_0" "$_t" "$C_D" "$(tag_date "$_t")" "$C_0"
		fi
	done
	printf '\n  номер (Enter — отмена): '; read -r _k
	[ -n "$_k" ] || return 0
	_t=$(printf '%s\n' $_tags | sed -n "${_k}p")
	[ -n "$_t" ] || { err "неверный номер"; return 1; }
	do_install "$_t"
}

install_local() {
	_z="${1:-}"
	if [ -z "$_z" ]; then
		_z=$(ls -1t /root/zapret2_*.zip /tmp/zapret2_*.zip 2>/dev/null | head -n1)
	fi
	[ -n "$_z" ] || die "положите zip в /root или /tmp, либо укажите путь: z2m local /root/file.zip"
	[ -f "$_z" ] || die "файл не найден: $_z"
	info "беру $_z"
	rm -rf "$WORK/pkg"; mkdir -p "$WORK/pkg"
	unzip -oq "$_z" -d "$WORK/pkg" || die "распаковка не удалась"
	check_conflicts
	backup_cfg
	install_pkgs "$WORK/pkg"
	detect_cfg
	ensure_strategies
	selftest
}

do_uninstall() {
	installed || die "zapret2 не установлен"
	backup_cfg
	"$INIT" stop >/dev/null 2>&1
	"$INIT" disable >/dev/null 2>&1
	pm_remove luci-app-zapret2 zapret2 >/dev/null 2>&1
	ask "Удалить также каталог $ZDIR?" && rm -rf "$ZDIR"
	ok "zapret2 удалён, бэкапы конфигов остались в $BACKUP_DIR"
	log "uninstalled"
}

# --------------------------------------------------------------- сервис ----
svc() {
	installed || die "zapret2 не установлен"
	"$INIT" "$1" || warn "команда '$1' вернула ошибку"
}
svc_quiet() { installed && "$INIT" "$1" >/dev/null 2>&1; return 0; }

daemon_running() { pgrep -f 'nfqws2' >/dev/null 2>&1; }

status() {
	detect_cfg
	say ""
	say "  ${C_B}Система${C_0}"
	say "    Модель    : $MODEL"
	say "    OpenWrt   : $OWRT   арх: $ARCH   пакеты: $(pm_name)   firewall: $FW"
	say ""
	if ! installed; then
		warn "zapret2 не установлен"
		return 0
	fi
	say "  ${C_B}zapret2${C_0}"
	_ver=$("$NFQ" --version 2>/dev/null | head -n1)
	say "    nfqws2    : ${_ver:-${C_R}не запускается${C_0}}"
	say "    конфиг    : $CFG_MODE${CFG_PREFIX:+ ($CFG_PREFIX)}"
	if daemon_running; then
		ok "демон запущен: pid $(pgrep -f nfqws2 | tr '\n' ' ')"
	else
		warn "демон не запущен"
	fi
	_opt=$(cfg_get NFQWS2_OPT 2>/dev/null)
	if [ -n "${_opt:-}" ]; then
		say ""
		say "  ${C_B}Текущая стратегия${C_0}"
		printf '%s\n' "$_opt" | sed 's/ --new /\n--new /g' | sed 's/^/    /'
	fi
	say ""
	say "  ${C_B}Последние сообщения${C_0}"
	logread -e nfqws2 2>/dev/null | tail -n 12 | sed 's/^/    /'
}

check_conflicts() {
	_rc=0
	[ -x /etc/init.d/zapret ] && { err "установлен zapret v1 — вместе с zapret2 не работает, удалите его"; _rc=1; }
	[ -x /etc/init.d/byedpi ] && { warn "обнаружен ByeDPI"; _rc=1; }
	[ -x /etc/init.d/youtubeUnblock ] && { warn "обнаружен youtubeUnblock"; _rc=1; }
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "1" ]; then
		warn "включён flow offloading — часть трафика пройдёт мимо nfqueue"; _rc=1
	fi
	_free=$(df -k /overlay 2>/dev/null | awk 'NR==2{print int($4/1024)}')
	if [ -n "${_free:-}" ] && [ "$_free" -lt 5 ]; then
		warn "мало места на overlay: ${_free} МБ"; _rc=1
	fi
	[ "$_rc" -eq 0 ] && ok "конфликтов не найдено"
	return 0
}

doctor() {
	detect_cfg
	say ""
	say "  ${C_B}Диагностика${C_0}"
	hr
	if installed; then ok "пакет zapret2 установлен"; else err "пакет zapret2 не установлен"; fi
	if [ -x "$NFQ" ]; then selftest; else err "бинарь nfqws2 не найден ($NFQ)"; fi
	if daemon_running; then ok "демон nfqws2 работает"; else warn "демон nfqws2 не запущен"; fi
	case "$CFG_MODE" in
		uci)  ok "конфиг: UCI ($CFG_PREFIX)" ;;
		file) ok "конфиг: файл $FILE_CFG" ;;
		*)    err "конфиг zapret2 не найден" ;;
	esac
	_opt=$(cfg_get NFQWS2_OPT 2>/dev/null)
	[ -n "${_opt:-}" ] && ok "стратегия задана ($(printf '%s' "$_opt" | wc -c) символов)" || warn "стратегия пустая"
	[ "$(cfg_get NFQWS2_ENABLE 2>/dev/null)" = "1" ] && ok "nfqws2 включён в конфиге" || warn "NFQWS2_ENABLE не равен 1"
	hr
	check_conflicts
	if [ "$FW" = nftables ]; then
		if nft list table inet zapret2 >/dev/null 2>&1 || nft list ruleset 2>/dev/null | grep -q 'nfqueue'; then
			ok "правила nfqueue в firewall присутствуют"
		else
			warn "правил nfqueue не видно — попробуйте: z2m fw"
		fi
	fi
	if [ "$(uci -q get 'dhcp.@dnsmasq[0].noresolv')" = "1" ]; then
		ok "DNS переопределён (похоже на DoH/DoT)"
	else
		warn "DNS провайдерский — часть блокировок так не обходится"
	fi
	quic_status
	hr
	info "полный лог менеджера: $LOGF"
}

# ------------------------------------------------------------ стратегии ----
ensure_strategies() {
	mkdir -p "$STRAT_DIR"
	ls "$STRAT_DIR"/*.conf >/dev/null 2>&1 && return 0
	write_default_strategies
	info "записал встроенные пресеты в $STRAT_DIR"
}

write_default_strategies() {
	mkdir -p "$STRAT_DIR"

	cat >"$STRAT_DIR/z1-default.conf" <<'EOF'
# name: default — штатная стратегия апстрима
# note: начинать всегда с неё, на многих провайдерах её достаточно
# ports_tcp: 80,443
# ports_udp: 443
--filter-tcp=80 --filter-l7=http --payload=http_req --lua-desync=fake:blob=fake_default_http:tcp_md5 --lua-desync=multisplit:pos=method+2 --new
--filter-tcp=443 --filter-l7=tls --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:tcp_seq=-10000 --lua-desync=multidisorder:pos=1,midsld --new
--filter-udp=443 --filter-l7=quic --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6
EOF

	cat >"$STRAT_DIR/z2-autottl.conf" <<'EOF'
# name: autottl — подбор TTL фейка автоматически
# note: когда фейк не долетает до DPI или наоборот ломает соединение
# ports_tcp: 80,443
# ports_udp: 443
--filter-tcp=80 --filter-l7=http --out-range=-d10 --payload=http_req --lua-desync=fake:blob=fake_default_http:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5 --lua-desync=fakedsplit:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5 --new
--filter-tcp=443 --filter-l7=tls --out-range=-d10 --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5 --lua-desync=multidisorder:pos=1,midsld
EOF

	cat >"$STRAT_DIR/z3-seqovl.conf" <<'EOF'
# name: seqovl — перекрытие TCP-последовательности
# note: против DPI, который собирает поток целиком
# ports_tcp: 80,443
# ports_udp: 443
--filter-tcp=80,443 --filter-l7=tls,http --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:tls_mod=rnd,rndsni,dupsid --payload=http_req --lua-desync=fake:blob=fake_default_http:tcp_md5 --payload=tls_client_hello,http_req --lua-desync=multisplit:pos=1:seqovl=5:seqovl_pattern=0x1603030000
EOF

	cat >"$STRAT_DIR/z4-youtube.conf" <<'EOF'
# name: youtube — SNI под google, много повторов фейка
# note: когда всё работает, а YouTube тормозит или рвётся
# ports_tcp: 80,443
# ports_udp: 443
--filter-tcp=443 --filter-l7=tls --out-range=-d10 --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=11:tls_mod=rnd,dupsid,sni=www.google.com --lua-desync=multidisorder:pos=1,midsld --new
--filter-udp=443 --filter-l7=quic --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=11
EOF

	cat >"$STRAT_DIR/z5-http-fakedsplit.conf" <<'EOF'
# name: http fakedsplit — для старого DPI по HTTP
# note: помогает там, где режется только незашифрованный HTTP
# ports_tcp: 80,443
# ports_udp: 443
--filter-tcp=80 --filter-l7=http --payload=http_req --lua-desync=fakedsplit:pos=method+2:tcp_ack=-66000:tcp_ts_up --new
--filter-tcp=443 --filter-l7=tls --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5 --lua-desync=multisplit:pos=1,midsld
EOF

	cat >"$STRAT_DIR/z6-quic.conf" <<'EOF'
# name: quic-only — дурим только QUIC
# note: когда TCP уже работает, а видео по UDP тормозит
# ports_tcp: 80,443
# ports_udp: 443
--filter-udp=443 --filter-l7=quic --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6:ip_autottl=-2,3-20
EOF
}

strat_meta() { sed -n "s/^# *$2: *//p" "$1" 2>/dev/null | head -n1; }
strat_opt()  { grep -v '^[[:space:]]*#' "$1" | sed '/^[[:space:]]*$/d'; }

strat_list() {
	ensure_strategies
	_cur=$(cfg_get NFQWS2_OPT 2>/dev/null | tr -d ' \n')
	say ""
	say "  ${C_B}Пресеты${C_0} ($STRAT_DIR)"
	_i=0
	for _f in "$STRAT_DIR"/*.conf; do
		[ -f "$_f" ] || continue
		_i=$((_i+1))
		_id=$(basename "$_f" .conf)
		_nm=$(strat_meta "$_f" name); [ -n "$_nm" ] || _nm="$_id"
		_mark=" "
		[ -n "$_cur" ] && [ "$(strat_opt "$_f" | tr -d ' \n')" = "$_cur" ] && _mark="*"
		printf '  %s %2d) %-22s %s\n' "$_mark" "$_i" "$_id" "$_nm"
	done
	[ "$_i" -gt 0 ] || warn "пресетов нет"
	say ""
	say "  ${C_D}* — совпадает с текущей стратегией${C_0}"
}

strat_resolve() { # id | номер | часть имени -> путь
	_q="$1"
	if [ -f "$STRAT_DIR/$_q.conf" ]; then printf '%s' "$STRAT_DIR/$_q.conf"; return 0; fi
	case "$_q" in
		''|*[!0-9]*) ;;
		*) ls -1 "$STRAT_DIR"/*.conf 2>/dev/null | sed -n "${_q}p"; return 0 ;;
	esac
	ls -1 "$STRAT_DIR"/*.conf 2>/dev/null | grep -m1 "/$_q" && return 0
	ls -1 "$STRAT_DIR"/*.conf 2>/dev/null | grep -m1 "$_q"
}

strat_show() {
	_f=$(strat_resolve "$1")
	[ -n "$_f" ] && [ -f "$_f" ] || die "пресет не найден: $1"
	say ""
	say "  ${C_B}$(basename "$_f" .conf)${C_0} — $(strat_meta "$_f" name)"
	_note=$(strat_meta "$_f" note); [ -n "$_note" ] && say "  ${C_D}$_note${C_0}"
	say ""
	strat_opt "$_f" | sed 's/^/    /'
}

strat_apply() {
	detect_cfg
	[ "$CFG_MODE" = none ] && die "конфиг zapret2 не найден — сначала установите пакет"
	_f=$(strat_resolve "$1")
	[ -n "$_f" ] && [ -f "$_f" ] || die "пресет не найден: $1"
	_opt=$(strat_opt "$_f")
	[ -n "$_opt" ] || die "пресет пустой: $_f"
	backup_cfg
	cfg_set NFQWS2_OPT "$_opt" || die "не смог записать стратегию в конфиг"
	_ptcp=$(strat_meta "$_f" ports_tcp); [ -n "$_ptcp" ] && cfg_set NFQWS2_PORTS_TCP "$_ptcp"
	_pudp=$(strat_meta "$_f" ports_udp); [ -n "$_pudp" ] && cfg_set NFQWS2_PORTS_UDP "$_pudp"
	cfg_set NFQWS2_ENABLE 1
	basename "$_f" .conf >"$CFGDIR/current" 2>/dev/null
	svc_quiet restart_daemons
	sleep 1
	if daemon_running; then
		ok "применён пресет $(basename "$_f" .conf)"
	else
		err "демон не поднялся — вероятно, ошибка в строке стратегии"
		logread -e nfqws2 2>/dev/null | tail -n 5 | sed 's/^/      /'
	fi
	log "strategy $(basename "$_f" .conf)"
}

strat_save() {
	_name="${1:-my-$(date +%Y%m%d-%H%M)}"
	detect_cfg
	_opt=$(cfg_get NFQWS2_OPT 2>/dev/null)
	[ -n "${_opt:-}" ] || die "текущая стратегия пустая"
	mkdir -p "$STRAT_DIR"
	_f="$STRAT_DIR/$_name.conf"
	{
		printf '# name: %s (сохранено %s)\n' "$_name" "$(date '+%F %T')"
		printf '# note: своя стратегия\n'
		printf '# ports_tcp: %s\n' "$(cfg_get NFQWS2_PORTS_TCP 2>/dev/null)"
		printf '# ports_udp: %s\n' "$(cfg_get NFQWS2_PORTS_UDP 2>/dev/null)"
		printf '%s\n' "$_opt"
	} >"$_f"
	ok "сохранено: $_f"
}

strat_edit() {
	detect_cfg
	_tmp="$WORK/strategy.txt"
	mkdir -p "$WORK"
	cfg_get NFQWS2_OPT 2>/dev/null >"$_tmp"
	${EDITOR:-vi} "$_tmp"
	_opt=$(sed '/^[[:space:]]*$/d' "$_tmp")
	[ -n "$_opt" ] || { warn "пусто, ничего не меняю"; return 0; }
	backup_cfg
	cfg_set NFQWS2_OPT "$_opt"
	svc_quiet restart_daemons
	sleep 1
	daemon_running && ok "применено" || err "демон не поднялся — проверьте синтаксис"
}

# --------------------------------------------------------- списки доменов --
hl_file() {
	case "${1:-user}" in
		ex|excl|exclude) printf '%s' "$HOSTS_EXCL" ;;
		*)               printf '%s' "$HOSTS_USER" ;;
	esac
}

hl_show() {
	_f=$(hl_file "${1:-user}")
	say ""
	say "  ${C_B}$_f${C_0}"
	if [ -s "$_f" ]; then sed 's/^/    /' "$_f"; else say "    (пусто)"; fi
}

hl_add() {
	_which="$1"; shift
	_f=$(hl_file "$_which")
	mkdir -p "$(dirname "$_f")"; touch "$_f"
	for _d in "$@"; do
		[ -n "$_d" ] || continue
		grep -qxF "$_d" "$_f" 2>/dev/null || printf '%s\n' "$_d" >>"$_f"
	done
	sort -u "$_f" -o "$_f"
	ok "добавлено в $(basename "$_f")"
	svc_quiet restart_daemons
}

hl_del() {
	_which="$1"; shift
	_f=$(hl_file "$_which")
	[ -f "$_f" ] || die "файла нет: $_f"
	for _d in "$@"; do
		grep -vxF "$_d" "$_f" >"$_f.tmp" 2>/dev/null && mv "$_f.tmp" "$_f"
	done
	ok "удалено из $(basename "$_f")"
	svc_quiet restart_daemons
}

bundle_is_exclude() {
	case "$(basename "$1")" in
		*exclude*|*-excl*|*.excl.txt) return 0 ;;
	esac
	head -n 3 "$1" 2>/dev/null | grep -qi 'exclude' && return 0
	return 1
}

bundle_count() {
	grep -v '^[[:space:]]*#' "$1" 2>/dev/null | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' '
}

bundle_list() {
	say ""
	say "  ${C_B}Готовые наборы${C_0} ($LISTS_DIR)"
	say ""
	_i=0
	for _f in "$LISTS_DIR"/*.txt; do
		[ -f "$_f" ] || continue
		_i=$((_i+1))
		if bundle_is_exclude "$_f"; then _tag="-> exclude"; else _tag="-> hostlist"; fi
		printf '  %2d) %-32s %6s доменов  %s\n' "$_i" "$(basename "$_f" .txt)" "$(bundle_count "$_f")" "$_tag"
	done
	if [ "$_i" -gt 0 ]; then
		say ""
		say "  Файлы с exclude в имени уходят в hostlist-exclude, остальные — в hostlist."
		say "  Переопределить: z2m list bundle <имя> hostlist|exclude"
	else
		warn "наборов нет (положите .txt в $LISTS_DIR)"
	fi
}

bundle_resolve() {
	_n="$1"
	[ -f "$LISTS_DIR/$_n.txt" ] && { printf '%s' "$LISTS_DIR/$_n.txt"; return 0; }
	[ -f "$LISTS_DIR/$_n" ]     && { printf '%s' "$LISTS_DIR/$_n"; return 0; }
	case "$_n" in
		''|*[!0-9]*) return 1 ;;
	esac
	_i=0
	for _f in "$LISTS_DIR"/*.txt; do
		[ -f "$_f" ] || continue
		_i=$((_i+1))
		[ "$_i" = "$_n" ] && { printf '%s' "$_f"; return 0; }
	done
	return 1
}

bundle_add() {
	[ -n "${1:-}" ] || { bundle_list; return 0; }
	_b=$(bundle_resolve "$1") || die "набор не найден: $1 (см. z2m list bundle)"
	_target="${2:-}"
	case "$_target" in
		ex|excl|exclude) _target=exclude ;;
		hl|host|hostlist|user) _target=user ;;
		*) if bundle_is_exclude "$_b"; then _target=exclude; else _target=user; fi ;;
	esac
	_f=$(hl_file "$_target")
	mkdir -p "$(dirname "$_f")"; touch "$_f"
	mkdir -p "$BACKUP_DIR"
	cp -f "$_f" "$BACKUP_DIR/$(basename "$_f").bak" 2>/dev/null
	_before=$(bundle_count "$_f")
	grep -v '^[[:space:]]*#' "$_b" | sed 's/[[:space:]]*$//' | sed '/^$/d' >>"$_f"
	sort -u "$_f" -o "$_f"
	_after=$(bundle_count "$_f")
	ok "$(basename "$_b" .txt) -> $(basename "$_f"): было $_before, стало $_after"
	svc_quiet restart_daemons
}

bundle_add_all() {
	_n=0
	for _f in "$LISTS_DIR"/*.txt; do
		[ -f "$_f" ] || continue
		bundle_is_exclude "$_f" || continue
		bundle_add "$(basename "$_f" .txt)" exclude
		_n=$((_n+1))
	done
	[ "$_n" -gt 0 ] || warn "exclude-наборов не найдено в $LISTS_DIR"
}

# ------------------------------------------------------------------ QUIC ----
quic_status() {
	if [ -n "$(uci -q get firewall.z2m_quic 2>/dev/null)" ]; then
		ok "блокировка QUIC включена (правило z2m_quic)"
	else
		info "блокировка QUIC выключена"
	fi
}

quic_on() {
	have uci || die "нет uci"
	uci -q delete firewall.z2m_quic
	uci set firewall.z2m_quic=rule
	uci set firewall.z2m_quic.name='z2m-block-quic'
	uci set firewall.z2m_quic.src='lan'
	uci set firewall.z2m_quic.dest='wan'
	uci set firewall.z2m_quic.proto='udp'
	uci set firewall.z2m_quic.dest_port='443'
	uci set firewall.z2m_quic.target='REJECT'
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	ok "QUIC заблокирован — браузеры откатятся на TCP"
}

quic_off() {
	have uci || die "нет uci"
	uci -q delete firewall.z2m_quic
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	ok "блокировка QUIC снята"
}

ipv6_set() {
	detect_cfg
	case "$1" in
		on)  cfg_set DISABLE_IPV6 0 && ok "IPv6 в zapret2 включён" ;;
		off) cfg_set DISABLE_IPV6 1 && ok "IPv6 в zapret2 выключен" ;;
		*)   die "usage: z2m ipv6 on|off" ;;
	esac
	svc_quiet restart
}

# ------------------------------------------------------------- автотестер --
# Проверка идёт параллельно и только по тем сайтам, которые реально
# заблокированы без обхода. Способ, который открыл всё, останавливает перебор.

default_domains() {
	cat <<'EOF'
www.youtube.com
rr1---sn-4g5e6nsz.googlevideo.com
discord.com
cdn.discordapp.com
x.com
instagram.com
rutracker.org
EOF
}

load_domains() {
	[ -f "$DOMAINS_FILE" ] || { mkdir -p "$CFGDIR"; default_domains >"$DOMAINS_FILE"; }
	grep -v '^[[:space:]]*#' "$DOMAINS_FILE" | sed '/^[[:space:]]*$/d'
}

probe_one() {
	_r=$(curl -sS -o /dev/null -r 0-0 --connect-timeout "$TEST_CONNECT" -m "$TEST_TIMEOUT" \
		-w '%{http_code} %{time_total}' "https://$1/" 2>/dev/null)
	_code=$(printf '%s' "$_r" | awk '{print $1}')
	_ms=$(printf '%s' "$_r" | awk '{printf "%d", $2*1000}')
	case "$_code" in
		2*|3*|4*) printf '1 %s %s\n' "${_ms:-0}" "$1" ;;
		*)        printf '0 0 %s\n' "$1" ;;
	esac
}

# stdout: "<открылось> <всего> <среднее ms>", детали в stderr,
# список неоткрывшихся — в файле $PROBE_FAIL (вызов часто идёт в подоболочке)
run_probes() {
	_list="$*"
	[ -n "$_list" ] || _list=$(load_domains)
	mkdir -p "$WORK"
	_pdir="$WORK/probe"; rm -rf "$_pdir"; mkdir -p "$_pdir"
	: >"$PROBE_FAIL"
	_n=0
	for _d in $_list; do
		_n=$((_n+1))
		probe_one "$_d" >"$_pdir/r$_n" 2>/dev/null &
		if [ $((_n % TEST_JOBS)) -eq 0 ]; then wait; fi
	done
	wait
	_ok=0; _all=0; _sum=0; _i=0
	while [ "$_i" -lt "$_n" ]; do
		_i=$((_i+1))
		[ -s "$_pdir/r$_i" ] || continue
		read -r _s _ms _dom <"$_pdir/r$_i"
		[ -n "${_dom:-}" ] || continue
		_all=$((_all+1))
		if [ "$_s" = "1" ]; then
			_ok=$((_ok+1)); _sum=$((_sum+_ms))
			if [ "${PROBE_QUIET:-0}" != "1" ]; then
				printf '      %sОК%s    %s  %s%s ms%s\n' "$C_G" "$C_0" "$_dom" "$C_D" "$_ms" "$C_0" >&2
			fi
		else
			printf '%s\n' "$_dom" >>"$PROBE_FAIL"
			if [ "${PROBE_QUIET:-0}" != "1" ]; then
				printf '      %sнет%s   %s\n' "$C_R" "$C_0" "$_dom" >&2
			fi
		fi
	done
	rm -rf "$_pdir"
	_avg=0; [ "$_ok" -gt 0 ] && _avg=$((_sum/_ok))
	printf '%s %s %s' "$_ok" "$_all" "$_avg"
}

test_all() {
	installed || die "zapret2 не установлен"
	have curl || die "нужен curl: opkg install curl"
	ensure_strategies
	detect_cfg
	[ "$CFG_MODE" = none ] && die "конфиг zapret2 не найден"
	mkdir -p "$WORK"
	backup_cfg >/dev/null 2>&1
	_saved=$(cfg_get NFQWS2_OPT 2>/dev/null)
	: >"$RESULTS"

	say ""
	info "шаг 1 · смотрю, что заблокировано без обхода"
	svc_quiet stop_daemons
	# shellcheck disable=SC2046
	set -- $(run_probes)
	_base_ok=$1; _base_all=$2
	_targets=$(head -n "$TEST_MAX_TARGETS" "$PROBE_FAIL" 2>/dev/null | tr '\n' ' ')
	if [ -z "$_targets" ]; then
		say ""
		ok "без обхода открылись все $_base_all сайта — подбирать нечего"
		say "  ${C_D}если у вас не открываются другие сайты — впишите их в $DOMAINS_FILE${C_0}"
		[ -n "${_saved:-}" ] && cfg_set NFQWS2_OPT "$_saved"
		svc_quiet restart_daemons
		return 0
	fi
	set -- $_targets; _ntarget=$#
	_nstrat=0
	for _f in "$STRAT_DIR"/*.conf; do [ -f "$_f" ] && _nstrat=$((_nstrat+1)); done
	_eta=$(( _nstrat * (TEST_SETTLE + TEST_TIMEOUT + 1) ))

	say ""
	info "шаг 2 · $_nstrat способов на $_ntarget сайтах, это до ~$_eta сек"
	say "  ${C_D}проверяю: $_targets${C_0}"
	say ""

	_best=""; _bestscore=-1; _bestavg=0
	for _f in "$STRAT_DIR"/*.conf; do
		[ -f "$_f" ] || continue
		_id=$(basename "$_f" .conf)
		_opt=$(strat_opt "$_f")
		[ -n "$_opt" ] || continue
		cfg_set NFQWS2_OPT "$_opt"
		_p=$(strat_meta "$_f" ports_tcp); [ -n "$_p" ] && cfg_set NFQWS2_PORTS_TCP "$_p"
		_p=$(strat_meta "$_f" ports_udp); [ -n "$_p" ] && cfg_set NFQWS2_PORTS_UDP "$_p"
		cfg_set NFQWS2_ENABLE 1
		svc_quiet restart_daemons
		sleep "$TEST_SETTLE"
		if ! daemon_running; then
			printf '    %s%-18s%s %sошибка в строке способа%s\n' "$C_R" "$_id" "$C_0" "$C_D" "$C_0"
			printf '%3s/%-3s %6s     %s\n' "0" "$_ntarget" "FAIL" "$_id" >>"$RESULTS"
			continue
		fi
		PROBE_QUIET=1
		# shellcheck disable=SC2046
		set -- $(run_probes $_targets)
		PROBE_QUIET=0
		_sc=$1; _avg=$3
		if [ "$_sc" -ge "$_ntarget" ]; then
			printf '    %s%-18s%s %s%s/%s%s  %s%s ms%s\n' "$C_G" "$_id" "$C_0" "$C_G" "$_sc" "$_ntarget" "$C_0" "$C_D" "$_avg" "$C_0"
		elif [ "$_sc" -gt 0 ]; then
			printf '    %-18s %s%s/%s%s  %s%s ms%s\n' "$_id" "$C_Y" "$_sc" "$_ntarget" "$C_0" "$C_D" "$_avg" "$C_0"
		else
			printf '    %s%-18s%s %s0/%s%s\n' "$C_D" "$_id" "$C_0" "$C_D" "$_ntarget" "$C_0"
		fi
		printf '%3d/%-3d %6s ms  %s\n' "$_sc" "$_ntarget" "$_avg" "$_id" >>"$RESULTS"
		if [ "$_sc" -gt "$_bestscore" ]; then _bestscore=$_sc; _best=$_id; _bestavg=$_avg; fi
		if [ "$_sc" -ge "$_ntarget" ] && [ "${Z2M_FULL:-0}" != "1" ]; then
			say ""
			ok "этот способ открыл всё — остальные не проверяю"
			break
		fi
	done

	say ""
	if [ -n "$_best" ] && [ "$_bestscore" -gt 0 ]; then
		strat_apply "$_best" >/dev/null 2>&1
		ok "оставил способ $_best — открыл $_bestscore из $_ntarget сайтов"
	else
		warn "ни один способ не помог — вернул как было"
		say "  ${C_D}попробуйте глубокий подбор (blockcheck2) в меню «Обход блокировок»${C_0}"
		[ -n "${_saved:-}" ] && cfg_set NFQWS2_OPT "$_saved"
		svc_quiet restart_daemons
	fi
	say ""
	say "  ${C_D}все результаты: $RESULTS · полный перебор: Z2M_FULL=1 z2m test${C_0}"
	log "test best=$_best score=$_bestscore/$_ntarget"
}

blockcheck() {
	_bc="$ZDIR/blockcheck2.sh"
	[ -f "$_bc" ] || die "blockcheck2.sh не найден (есть не во всех сборках пакета)"
	warn "blockcheck остановит zapret2 и может работать десятки минут"
	ask "Продолжить?" || return 0
	mkdir -p "$CFGDIR"
	_log="$CFGDIR/blockcheck-$(date +%Y%m%d-%H%M%S).log"
	svc_quiet stop
	sh "$_bc" 2>&1 | tee "$_log"
	svc_quiet start
	ok "лог сохранён: $_log"
	info "готовые строки стратегий ищите в разделе summary в конце лога"
}

# --------------------------------------------------- установка менеджера ---
install_self() {
	_src=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
	_dir=$(dirname "$_src")
	mkdir -p "$CFGDIR" "$STRAT_DIR" "$LISTS_DIR" "$BACKUP_DIR"
	if [ "$_src" != "$SELF_PATH" ]; then
		cp "$_src" "$SELF_PATH" || die "не смог скопировать в $SELF_PATH"
		chmod +x "$SELF_PATH"
	fi
	[ -d "$_dir/strategies" ] && cp -f "$_dir/strategies/"*.conf "$STRAT_DIR/" 2>/dev/null
	[ -d "$_dir/lists" ] && cp -f "$_dir/lists/"*.txt "$LISTS_DIR/" 2>/dev/null
	ensure_strategies
	[ -f "$DOMAINS_FILE" ] || default_domains >"$DOMAINS_FILE"
	ok "z2m $Z2M_VERSION установлен. Запуск: z2m"
}

update_self() {
	[ -n "$SELF_REPO" ] || die "не задан репозиторий: Z2M_SELF_REPO=owner/repo z2m update-self"
	mkdir -p "$WORK" "$BACKUP_DIR"
	_new="$WORK/z2m.new"
	dl_file "https://raw.githubusercontent.com/$SELF_REPO/$SELF_BRANCH/z2m" "$_new" || die "скачивание не удалось"
	head -n1 "$_new" | grep -q '^#!/bin/sh' || die "скачался не тот файл"
	sh -n "$_new" 2>/dev/null || die "в скачанном скрипте синтаксическая ошибка — обновление отменено"
	[ -f "$SELF_PATH" ] && cp "$SELF_PATH" "$BACKUP_DIR/z2m-$(date +%Y%m%d-%H%M%S).bak"
	mv "$_new" "$SELF_PATH"; chmod +x "$SELF_PATH"
	ok "обновлено до $("$SELF_PATH" version 2>/dev/null)"
}

# ------------------------------------------------------------------ меню ---
cur_strategy() { cat "$CFGDIR/current" 2>/dev/null; }
autostart_on() { [ -x "$INIT" ] && "$INIT" enabled >/dev/null 2>&1; }

if [ "${Z2M_ASCII:-0}" = "1" ]; then
	G_TL="+--"; G_BAR="|"; G_BL="+--"; G_LN="-"; G_DOT="*"; G_ARR=">"
else
	G_TL="┏━━"; G_BAR="┃"; G_BL="┗━━"; G_LN="━"; G_DOT="●"; G_ARR="›"
fi

rule() {
	_w=${1:-40}; _r=""; _i=0
	while [ "$_i" -lt "$_w" ]; do _r="$_r$G_LN"; _i=$((_i+1)); done
	printf '%s' "$_r"
}
RULE_TOP=$(rule 38)
RULE_BOT=$(rule 44)

state_text() {
	if ! installed; then
		printf '%s%s zapret2 не установлен%s' "$C_D" "$G_DOT" "$C_0"
		return 0
	fi
	if daemon_running; then
		printf '%s%s обход работает%s' "$C_G" "$G_DOT" "$C_0"
	else
		printf '%s%s выключен%s' "$C_Y" "$G_DOT" "$C_0"
	fi
	_c=$(cur_strategy)
	[ -n "$_c" ] && printf '%s · способ %s%s' "$C_D" "$_c" "$C_0"
	if autostart_on; then printf '%s · автозапуск%s' "$C_D" "$C_0"; fi
	return 0
}

header() {
	clear 2>/dev/null
	say ""
	printf '  %s%s Z2M %s%s\n' "$C_B" "$G_TL" "$RULE_TOP" "$C_0"
	printf '  %s%s%s  %sменеджер zapret2 для OpenWrt · v%s%s\n' "$C_B" "$G_BAR" "$C_0" "$C_D" "$Z2M_VERSION" "$C_0"
	printf '  %s%s%s  %s%s · OpenWrt %s · %s%s\n' "$C_B" "$G_BAR" "$C_0" "$C_D" "$MODEL" "$OWRT" "$ARCH" "$C_0"
	printf '  %s%s%s  %s\n' "$C_B" "$G_BAR" "$C_0" "$(state_text)"
	printf '  %s%s%s%s\n' "$C_B" "$G_BL" "$RULE_BOT" "$C_0"
	say ""
}

crumb() { printf '  %s%s %s%s%s\n\n' "$C_D" "Z2M" "$G_ARR " "$1" "$C_0"; }
mi()    { printf '   %s%s%s  %s\n' "$C_B" "$1" "$C_0" "$2"; }
msub()  { printf '      %s%s%s\n' "$C_D" "$1" "$C_0"; }
prompt(){ printf '\n  %s%s%s ' "$C_B" "$G_ARR" "$C_0"; }

quick_setup() {
	header
	crumb "Быстрая настройка"
	say "  ${C_D}Четыре шага. Где спрашиваю — Enter означает «нет».${C_0}"
	say ""
	if installed; then
		ok "1/4 · zapret2 уже стоит"
	else
		say "  ${C_B}1/4${C_0} · ставлю zapret2"
		if ! do_install; then pause; return 1; fi
	fi
	say ""
	say "  ${C_B}2/4${C_0} · списки сайтов"
	if ask "Залить готовые исключения (банки, госуслуги, античиты)?"; then
		bundle_add_all
	else
		say "  ${C_D}пропустил${C_0}"
	fi
	say ""
	say "  ${C_B}3/4${C_0} · способ обхода"
	if ask "Подобрать автоматически? (около минуты)"; then
		test_all
	else
		strat_apply z1-default
	fi
	say ""
	say "  ${C_B}4/4${C_0} · автозапуск"
	svc_quiet enable
	ok "включится сам при старте роутера"
	say ""
	status
	pause
}

menu_strategy() {
	while :; do
		header
		crumb "Обход блокировок"
		mi 1 "Подобрать автоматически"
		msub "проверю только заблокированные сайты и сразу применю лучший"
		say ""
		mi 2 "Выбрать вручную"
		mi 3 "Что применено сейчас"
		mi 4 "Посмотреть вариант"
		mi 5 "Глубокий подбор (blockcheck2)"
		mi 6 "Правка строки вручную"
		mi 7 "Сохранить текущее как свой вариант"
		say ""
		mi 0 "Назад"
		prompt; read -r c
		case "$c" in
			1) test_all; pause ;;
			2) strat_list; printf '\n  номер или имя: '; read -r x; [ -n "$x" ] && strat_apply "$x"; pause ;;
			3) status; pause ;;
			4) strat_list; printf '\n  номер или имя: '; read -r x; [ -n "$x" ] && strat_show "$x"; pause ;;
			5) blockcheck; pause ;;
			6) strat_edit; pause ;;
			7) printf '  имя: '; read -r x; strat_save "$x"; pause ;;
