menu_system() {
	while :; do
		header
		crumb "Обслуживание"
		mi 1 "Обновить zapret2"
		mi 2 "Выбрать версию вручную"
		mi 3 "Поставить из файла zip"
		mi 4 "Удалить zapret2"
		say ""
		mi 5 "Блокировка QUIC"
		mi 6 "IPv6"
		mi 7 "Бэкап и восстановление"
		mi 8 "Правка конфига zapret2"
